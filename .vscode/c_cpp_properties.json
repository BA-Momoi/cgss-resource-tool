{
    "configurations": [
        {
            "name": "CGSS MinGW x64",
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/build_gui/compile_commands.json",
            "defines": [
                "CIMGUI_DEFINE_ENUMS_AND_STRUCTS=1",
                "CIMGUI_USE_SDL3=1"
            ],
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/gui",
                "${workspaceFolder}/build/_spine36b/spine-c/spine-c/include",
                "${workspaceFolder}/../SDL2/cimgui",
                "${workspaceFolder}/../SDL2/cimgui/imgui",
                "${workspaceFolder}/../SDL2/cimgui/imgui/backends",
                "${workspaceFolder}/../sdl3_src/SDL3-3.4.14/include",
                "${workspaceFolder}/../sdl3_src/SDL3-3.4.14/src/video"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/gui",
                    "${workspaceFolder}/build/_spine36b/spine-c/spine-c/include",
                    "${workspaceFolder}/../SDL2/cimgui",
                    "${workspaceFolder}/../sdl3_src/SDL3-3.4.14/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
